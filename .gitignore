# Track only the inputs required to build and publish Vectora.
# Everything else stays local by default. Do not force-add development files.
/*

# Application entry point and reproducible build configuration.
!/.gitignore
!/index.html
!/package.json
!/package-lock.json
!/tsconfig.json

# GitHub Pages deployment.
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/deploy.yml

# Application source, workers, type declarations and shared styles.
!/src/
/src/**
!/src/**/
!/src/**/*.ts
!/src/**/*.css

# Runtime icons, fonts and single-line glyph data.
!/public/
/public/*
!/public/favicon.png
!/public/favicon.svg
!/public/fonts/
/public/fonts/*
!/public/fonts/*.ttf
!/public/fonts/*.otf
!/public/fonts/*.json

# Keep bundled-font licences, required acknowledgements and source attribution.
!/public/fonts/*-OFL.txt
!/public/fonts/OFL.txt
!/public/fonts/Hershey-NOTICE.txt
!/public/fonts/FreeFont-LICENSE.txt
!/public/fonts/FreeFont-COPYING.txt
!/public/fonts/FreeFont-AUTHORS.txt
!/public/fonts/FreeFont-README.txt
!/public/fonts/README.md

# Explicit local-only test policy, including fixtures and test configuration.
/tests/
/playwright.config.ts

# Exclude local secrets and generated files even inside allowed source folders.
**/.env
**/.env.*
**/.DS_Store
**/*.log
**/*.tsbuildinfo
**/__pycache__/
